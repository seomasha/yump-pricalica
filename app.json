        "backgroundColor": "#ffffff"
      },
      "package": "com.mashasead.yumppricalica"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b24d3317-ad5e-4193-a47f-9123c9cc1867"
      }
    },
    "owner": "seadmasha"
  }
